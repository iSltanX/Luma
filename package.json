{
  "name": "luma",
  "version": "0.1.0",
  "description": "محرر كتابة هادئ للكاتب العربي على macOS",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "tauri dev",
    "app:build": "tauri build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:rust": "cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo fmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run check:rust && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.9.2",
    "lexical": "^0.38.0",
    "@lexical/rich-text": "^0.38.0",
    "@lexical/history": "^0.38.0",
    "@lexical/utils": "^0.38.0",
    "@lexical/selection": "^0.38.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.42.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
